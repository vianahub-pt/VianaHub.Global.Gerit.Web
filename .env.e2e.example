# Copy this file to .env.e2e.local and add credentials for local authenticated E2E runs.
# The local file is ignored by Git. Existing shell/CI variables take precedence.
# Local E2E always starts its own Gerit Web server on this address.
E2E_BASE_URL=http://127.0.0.1:3100

# Required for protected Actions E2E scenarios. Do not put real credentials in this example.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
